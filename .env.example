# 复制为 .env 后按需修改；docker compose 会自动读取同目录 .env
# 管理密钥（所有写接口必须携带）
MANAGEMENT_KEY=change-me-management-key
# TSIG 共享密钥（base64），须与 BIND 的 BIND_TSIG_SECRET 一致
TSIG_SECRET=CSK3OtjVklBJ0yPyeDrLpOfBypbMLSITQNqNv17GEJ0=
TSIG_KEY_NAME=acme-key.
TSIG_ALGORITHM=hmac-sha256
# 域名白名单（逗号分隔，支持 *.suffix 通配）
ALLOWED_DOMAINS=acme.test,*.acme.test
